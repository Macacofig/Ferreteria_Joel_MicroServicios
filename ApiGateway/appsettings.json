{
  "Keycloak": {
    "Authority": "http://localhost:8081/realms/ferreteria",
    "ValidIssuer": "http://localhost:8081/realms/ferreteria",
    "MetadataAddress": ""
  },
  "ReverseProxy": {
    "Routes": {
      "usuarios-login": {
        "ClusterId": "usuarios",
        "Order": -1,
        "Match": { "Path": "/api/usuarios/login" }
      },
      "usuarios-activar": {
        "ClusterId": "usuarios",
        "Order": -1,
        "Match": { "Path": "/api/usuarios/activar" }
      },
      "usuarios-activar-validar": {
        "ClusterId": "usuarios",
        "Order": -1,
        "Match": { "Path": "/api/usuarios/activar/validar" }
      },
      "usuarios": {
        "ClusterId": "usuarios",
        "Match": { "Path": "/api/usuarios/{**catch-all}" },
        "AuthorizationPolicy": "Default"
      },
      "productos": {
        "ClusterId": "productos",
        "Match": { "Path": "/api/productos/{**catch-all}" },
        "AuthorizationPolicy": "Default"
      },
      "clientes": {
        "ClusterId": "clientes",
        "Match": { "Path": "/api/clientes/{**catch-all}" },
        "AuthorizationPolicy": "Default"
      },
      "proveedores": {
        "ClusterId": "proveedores",
        "Match": { "Path": "/api/proveedores/{**catch-all}" },
        "AuthorizationPolicy": "Default"
      }
    },
    "Clusters": {
      "usuarios": {
        "Destinations": {
          "principal": { "Address": "http://microservicio-usuarios:8080/" }
        }
      },
      "productos": {
        "Destinations": {
          "principal": { "Address": "http://microservicio-productos:8080/" }
        }
      },
      "clientes": {
        "Destinations": {
          "principal": { "Address": "http://microservicio-clientes:8080/" }
        }
      },
      "proveedores": {
        "Destinations": {
          "principal": { "Address": "http://microservicio-proveedores:8080/" }
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
