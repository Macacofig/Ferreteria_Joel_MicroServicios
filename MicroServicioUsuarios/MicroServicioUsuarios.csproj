<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>FERRETERIA__Joel.MicroServicioUsuarios</RootNamespace>
    <AssemblyName>MicroServicioUsuarios</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Validacion de los JWT emitidos por Keycloak mediante JWKS. -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.14" />
    <!-- Persistencia: unico proveedor permitido (MySql.Data). -->
    <PackageReference Include="MySql.Data" Version="26.7.0" />
    <!-- Hash de contrasenas con Argon2id. -->
    <PackageReference Include="Isopoh.Cryptography.Argon2" Version="2.0.0" />
    <!-- Envio del enlace de activacion por SMTP. -->
    <PackageReference Include="MailKit" Version="4.18.1" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

</Project>
