# =============================================================================
# FERRETERÍA JOEL - Configuración del despliegue (3raCompetencia)
# Copie este archivo a .env y ajuste los valores. No se versiona.
# =============================================================================

# --- Bases de datos ---------------------------------------------------------
MYSQL_USUARIOS_ROOT_PASSWORD=usuarios_root_2026
MYSQL_PRODUCTOS_ROOT_PASSWORD=productos_root_2026
POSTGRES_CLIENTES_PASSWORD=clientes_root_2026

# --- Clave compartida para cifrar el enlace de activación (AES-GCM) ---------
# Debe ser idéntica en el microservicio de usuarios y en el frontend.
URL_PROTECCION_CLAVE=ferreteria-joel-url-proteccion-clave-compartida-2026

# --- Keycloak ---------------------------------------------------------------
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# --- Puertos en el host -----------------------------------------------------
MYSQL_USUARIOS_PUERTO=3307
MYSQL_PRODUCTOS_PUERTO=3308
POSTGRES_CLIENTES_PUERTO=5433
MONGO_PROVEEDORES_PUERTO=27018
KEYCLOAK_PUERTO=8081
MICROSERVICIO_PRODUCTOS_PUERTO=5071
MICROSERVICIO_USUARIOS_PUERTO=5072
MICROSERVICIO_CLIENTES_PUERTO=5073
MICROSERVICIO_PROVEEDORES_PUERTO=5074
APIGATEWAY_PUERTO=5000
FRONTEND_PUERTO=5267

# --- SMTP para activación de cuentas (vacío = modo desarrollo) --------------
Smtp__Host=
Smtp__Puerto=587
Smtp__Usuario=
Smtp__Clave=
Smtp__UsarSsl=true
Smtp__Remitente=
Smtp__RemitenteNombre=Ferreteria Joel
