@page "{id:int}"
@model FERRETERIA__Joel.Pages.Proveedores.DetalleModel
@using System.Globalization
@{
    ViewData["Title"] = "Detalle de proveedor";
    ViewData["ActiveMenu"] = "Proveedores";
    var cultura = new CultureInfo("es-ES");
}

@section Styles {
    <link rel="stylesheet" href="~/css/productos.css" asp-append-version="true" />
}

<div class="fj-container fj-page-products">
    <section class="fj-page-head">
        <p class="fj-eyebrow">Módulo · Proveedores</p>
        <h1>Detalle del proveedor</h1>
        <p class="fj-page-sub">Consulta de la información registrada del proveedor.</p>
    </section>

    @if (Model.Proveedor is null)
    {
        <div class="fj-alert" role="alert">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="10" />
                <line x1="12" y1="8" x2="12" y2="12" />
                <line x1="12" y1="16" x2="12.01" y2="16" />
            </svg>
            <span>No se encontró el proveedor solicitado.</span>
        </div>
    }
    else
    {
        <section class="fj-card">
            <div class="fj-form" style="padding-bottom:0;">
                <dl class="fj-perfil-datos" style="margin:0;">
                    <div>
                        <dt>ID</dt>
                        <dd>@Model.Proveedor.Id</dd>
                    </div>
                    <div>
                        <dt>Razón social</dt>
                        <dd>@Model.Proveedor.RazonSocial</dd>
                    </div>
                    <div>
                        <dt>NIT</dt>
                        <dd>@Model.Proveedor.Nit</dd>
                    </div>
                    <div>
                        <dt>Contacto</dt>
                        <dd>@Model.Proveedor.Contacto</dd>
                    </div>
                    <div>
                        <dt>Teléfono</dt>
                        <dd>@Model.Proveedor.Telefono</dd>
                    </div>
                    <div>
                        <dt>Responsable</dt>
                        <dd>@(string.IsNullOrWhiteSpace(Model.Proveedor.NombreResponsable) ? "No registrado" : Model.Proveedor.NombreResponsable)</dd>
                    </div>
                    <div>
                        <dt>Estado</dt>
                        <dd>
                            <span class="fj-pill" style="--pill: @(Model.Proveedor.Estado ? "var(--success)" : "var(--texto-ter)");">@(Model.Proveedor.Estado ? "Activo" : "Inactivo")</span>
                        </dd>
                    </div>
                    <div>
                        <dt>Fecha de creación</dt>
                        <dd>@Model.Proveedor.FechaCreacion.ToString("g", cultura) @(string.IsNullOrWhiteSpace(Model.Proveedor.UsuarioCreacion) ? "" : $"· {Model.Proveedor.UsuarioCreacion}")</dd>
                    </div>
                    <div>
                        <dt>Fecha de modificación</dt>
                        <dd>@(Model.Proveedor.FechaModificacion?.ToString("g", cultura) ?? "—") @(string.IsNullOrWhiteSpace(Model.Proveedor.UsuarioModificacion) ? "" : $"· {Model.Proveedor.UsuarioModificacion}")</dd>
                    </div>
                    @if (!Model.Proveedor.Estado)
                    {
                        <div>
                            <dt>Fecha de baja</dt>
                            <dd>@(Model.Proveedor.FechaBaja?.ToString("g", cultura) ?? "—") @(string.IsNullOrWhiteSpace(Model.Proveedor.UsuarioBaja) ? "" : $"· {Model.Proveedor.UsuarioBaja}")</dd>
                        </div>
                    }
                </dl>
            </div>

            <div class="fj-form-actions" style="padding:0 1.75rem 1.75rem;">
                <a asp-page="./Index" class="fj-btn fj-btn-ghost">Volver al listado</a>
                <a asp-page="./Editar" asp-route-id="@Model.Proveedor.Id" class="fj-btn fj-btn-edit">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" /><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" /></svg>
                    Editar
                </a>
                @if (Model.Proveedor.Estado)
                {
                    <form method="post"
                          asp-page-handler="Eliminar"
                          asp-route-id="@Model.Proveedor.Id"
                          class="fj-inline-form"
                          data-fj-confirm="¿Está seguro de dar de baja al proveedor '@Model.Proveedor.RazonSocial'? Podrá reactivarlo después.">
                        <button type="submit" class="fj-btn fj-btn-danger">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="3 6 5 6 21 6" /><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" /></svg>
                            Dar de baja
                        </button>
                    </form>
                }
                else
                {
                    <form method="post"
                          asp-page-handler="Reactivar"
                          asp-route-id="@Model.Proveedor.Id"
                          class="fj-inline-form"
                          data-fj-confirm="¿Desea reactivar al proveedor '@Model.Proveedor.RazonSocial'?">
                        <button type="submit" class="fj-btn fj-btn-ghost">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7L3 8" /><polyline points="3 3 3 8 8 8" /></svg>
                            Reactivar
                        </button>
                    </form>
                }
            </div>
        </section>
    }
</div>

<partial name="_ConfirmModal" />
