@page
@model FERRETERIA__Joel.Pages.Proveedores.CrearModel
@{
    ViewData["Title"] = "Registrar proveedor";
    ViewData["ActiveMenu"] = "Proveedores";
}

@section Styles {
    <link rel="stylesheet" href="~/css/productos.css" asp-append-version="true" />
}

<div class="fj-container fj-page-products">

    <section class="fj-page-head">
        <p class="fj-eyebrow">Módulo · Proveedores · Alta</p>
        <h1>Nuevo Proveedor</h1>
        <p class="fj-page-sub">Registro de un proveedor en el sistema de la ferretería.</p>
    </section>

    @if (TempData["MensajeError"] != null)
    {
        <div class="fj-alert" role="alert">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10" /><line x1="12" y1="8" x2="12" y2="12" /><line x1="12" y1="16" x2="12.01" y2="16" /></svg>
            <span>@TempData["MensajeError"]</span>
        </div>
    }

    <section class="fj-card" aria-label="Formulario de nuevo proveedor">
        <form method="post" class="fj-form-producto">
            <div class="fj-fila fj-fila-2">
                <div class="fj-campo">
                    <label class="form-label" asp-for="Formulario.RazonSocial">Razón social</label>
                    <input class="form-control" asp-for="Formulario.RazonSocial" maxlength="150" required
                           pattern="[A-Za-zÁÉÍÓÚáéíóúÑñÜü0-9 ]+"
                           title="Solo letras, números y espacios (sin símbolos especiales)." />
                    <span class="text-danger" asp-validation-for="Formulario.RazonSocial"></span>
                </div>

                <div class="fj-campo">
                    <label class="form-label" asp-for="Formulario.Nit">NIT</label>
                    <input class="form-control" asp-for="Formulario.Nit" maxlength="30" required
                           inputmode="numeric" pattern="[0-9]+"
                           title="Solo números." />
                    <span class="text-danger" asp-validation-for="Formulario.Nit"></span>
                </div>
            </div>

            <div class="fj-fila fj-fila-2">
                <div class="fj-campo">
                    <label class="form-label" asp-for="Formulario.Contacto">Contacto</label>
                    <input class="form-control" asp-for="Formulario.Contacto" maxlength="100" required
                           pattern="[A-Za-zÁÉÍÓÚáéíóúÑñÜü ]+"
                           title="Solo letras y espacios (sin números ni símbolos especiales)." />
                    <span class="text-danger" asp-validation-for="Formulario.Contacto"></span>
                </div>

                <div class="fj-campo">
                    <label class="form-label" asp-for="Formulario.Telefono">Teléfono</label>
                    <input class="form-control" asp-for="Formulario.Telefono" type="tel" required
                           inputmode="numeric" maxlength="8" minlength="8" pattern="[5-7][0-9]{7}"
                           title="Debe tener 8 dígitos y comenzar con 5, 6 o 7." />
                    <span class="text-danger" asp-validation-for="Formulario.Telefono"></span>
                </div>
            </div>

            <div class="fj-fila fj-fila-1 fj-fila--ultima">
                <div class="fj-campo">
                    <label class="form-label" asp-for="Formulario.NombreResponsable">Responsable</label>
                    <input class="form-control fj-codigo-autogenerado" asp-for="Formulario.NombreResponsable" readonly
                           title="Se registrará el nombre del usuario que realiza el registro." />
                    <span class="text-danger" asp-validation-for="Formulario.NombreResponsable"></span>
                </div>
            </div>

            <div class="fj-barra-botones">
                <a class="fj-btn fj-btn-ghost" asp-page="./Index">Cancelar</a>
                <button type="submit" class="fj-btn fj-btn-primary">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z" /><polyline points="17 21 17 13 7 13 7 21" /><polyline points="7 3 7 8 15 8" /></svg>
                    Guardar Proveedor
                </button>
            </div>
        </form>
    </section>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
