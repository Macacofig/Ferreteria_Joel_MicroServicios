@page
@model FERRETERIA__Joel.Pages.Proveedores.CrearModel
@{
    ViewData["Title"] = "Registrar proveedor";
    ViewData["ActiveMenu"] = "Proveedores";
}

@section Styles {
    <link rel="stylesheet" href="~/css/productos.css" asp-append-version="true" />
}

<div class="fj-container fj-page-products">
    <section class="fj-page-head">
        <p class="fj-eyebrow">Módulo · Proveedores</p>
        <h1>Registrar proveedor</h1>
        <p class="fj-page-sub">Complete los datos para registrar un nuevo proveedor.</p>
    </section>

    @if (TempData["MensajeError"] != null)
    {
        <div class="fj-alert" role="alert">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="10" />
                <line x1="12" y1="8" x2="12" y2="12" />
                <line x1="12" y1="16" x2="12.01" y2="16" />
            </svg>
            <span>@TempData["MensajeError"]</span>
        </div>
    }

    <section class="fj-card">
        <form method="post" class="fj-form">
            <div class="fj-form-grid">
                <div class="fj-form-field">
                    <label class="fj-form-label" asp-for="Formulario.RazonSocial">Razón social</label>
                    <input class="fj-input" asp-for="Formulario.RazonSocial" maxlength="150" required
                           pattern="[A-Za-zÁÉÍÓÚáéíóúÑñÜü0-9 ]+"
                           title="Solo letras, números y espacios (sin símbolos especiales)." />
                    <span class="fj-form-hint">Solo letras, números y espacios (sin símbolos especiales).</span>
                    <span asp-validation-for="Formulario.RazonSocial" style="color:var(--danger);font-size:.78rem;"></span>
                </div>
                <div class="fj-form-field">
                    <label class="fj-form-label" asp-for="Formulario.Nit">NIT</label>
                    <input class="fj-input" asp-for="Formulario.Nit" maxlength="30" required
                           inputmode="numeric" pattern="[0-9]+"
                           title="Solo números." />
                    <span class="fj-form-hint">Solo números.</span>
                    <span asp-validation-for="Formulario.Nit" style="color:var(--danger);font-size:.78rem;"></span>
                </div>
                <div class="fj-form-field">
                    <label class="fj-form-label" asp-for="Formulario.Contacto">Contacto</label>
                    <input class="fj-input" asp-for="Formulario.Contacto" maxlength="100" required
                           pattern="[A-Za-zÁÉÍÓÚáéíóúÑñÜü ]+"
                           title="Solo letras y espacios (sin números ni símbolos especiales)." />
                    <span class="fj-form-hint">Solo letras y espacios (sin números ni símbolos especiales).</span>
                    <span asp-validation-for="Formulario.Contacto" style="color:var(--danger);font-size:.78rem;"></span>
                </div>
                <div class="fj-form-field">
                    <label class="fj-form-label" asp-for="Formulario.Telefono">Teléfono</label>
                    <input class="fj-input" asp-for="Formulario.Telefono" type="tel" required
                           inputmode="numeric" maxlength="8" minlength="8" pattern="[5-7][0-9]{7}"
                           title="Debe tener 8 dígitos y comenzar con 5, 6 o 7." />
                    <span class="fj-form-hint">8 dígitos, debe iniciar con 5, 6 o 7.</span>
                    <span asp-validation-for="Formulario.Telefono" style="color:var(--danger);font-size:.78rem;"></span>
                </div>
                <div class="fj-form-field fj-form-field--full">
                    <label class="fj-form-label" asp-for="Formulario.NombreResponsable">Responsable</label>
                    <input class="fj-input" asp-for="Formulario.NombreResponsable" readonly />
                    <span class="fj-form-hint">Se registrará el nombre del usuario que realiza el registro.</span>
                </div>
            </div>

            <div class="fj-form-actions">
                <a asp-page="./Index" class="fj-btn fj-btn-ghost">Cancelar</a>
                <button type="submit" class="fj-btn fj-btn-primary">Guardar</button>
            </div>
        </form>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
