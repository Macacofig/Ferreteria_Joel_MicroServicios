@page
@model FERRETERIA__Joel.Pages.Proveedores.IndexModel
@using System.Globalization
@{
    ViewData["Title"] = "Proveedores";
    ViewData["ActiveMenu"] = "Proveedores";

    var cultura = new CultureInfo("es-ES");

    string DireccionDe() => Model.Orden == "asc" ? "desc" : "asc";

    string FlechaDe() => Model.Orden == "asc" ? " ↑" : " ↓";
}

@section Styles {
    <link rel="stylesheet" href="~/css/productos.css" asp-append-version="true" />
}

<div class="fj-container fj-page-products">

    <section class="fj-page-head">
        <p class="fj-eyebrow">Módulo · Proveedores</p>
        <h1>Proveedores</h1>
        <p class="fj-page-sub">Gestión de proveedores con listado, consulta, registro, edición y baja lógica.</p>
    </section>

    @if (TempData["Mensaje"] != null)
    {
        <div class="fj-alert fj-alert-success" role="status">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" /><polyline points="22 4 12 14.01 9 11.01" /></svg>
            <span>@TempData["Mensaje"]</span>
        </div>
    }

    @if (TempData["MensajeError"] != null)
    {
        <div class="fj-alert" role="alert">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10" /><line x1="12" y1="8" x2="12" y2="12" /><line x1="12" y1="16" x2="12.01" y2="16" /></svg>
            <span>@TempData["MensajeError"]</span>
        </div>
    }

    <section class="fj-toolbar fj-toolbar-simple">
        <p class="fj-toolbar-count">
            <strong>@Model.Proveedores.Count</strong>
            @(Model.Proveedores.Count == 1 ? "proveedor registrado" : "proveedores registrados")
        </p>

        <div class="fj-toolbar-actions prod-toolbar-controls">
            <form method="get" class="fj-inline-form">
                <label for="orden" class="prod-toolbar-label">Ordenar por</label>
                <select id="orden" name="orden" class="prod-select"
                        aria-label="Ordenar por razón social"
                        onchange="this.form.submit()">
                    <option value="asc" selected="@(Model.Orden == "asc")">Razón social (A-Z)</option>
                    <option value="desc" selected="@(Model.Orden == "desc")">Razón social (Z-A)</option>
                </select>
            </form>

            <a class="fj-btn fj-btn-primary" asp-page="./Crear">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" /></svg>
                Registrar proveedor
            </a>
        </div>
    </section>

    <section class="fj-card fj-table-card" aria-label="Listado de proveedores">
        <div class="fj-table-wrap fj-table-wrap-scroll prod-table-wrap">
            <table class="fj-table fj-table-productos prod-table">
                <thead>
                    <tr>
                        <th scope="col">ID</th>
                        <th scope="col">
                            <a asp-page="./Index" asp-route-orden="@DireccionDe()">Razón social @(FlechaDe())</a>
                        </th>
                        <th scope="col">Contacto</th>
                        <th scope="col">Teléfono</th>
                        <th scope="col">Responsable</th>
                        <th scope="col">Estado</th>
                        <th scope="col" class="fj-td-acciones">Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model.Proveedores.Count == 0)
                    {
                        <tr>
                            <td colspan="7" class="fj-table-vacio">
                                <div class="fj-empty">
                                    <span class="fj-empty-ico" aria-hidden="true">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" /><polyline points="3.27 6.96 12 12.01 20.73 6.96" /><line x1="12" y1="22.08" x2="12" y2="12" /></svg>
                                    </span>
                                    <p>Sin proveedores registrados</p>
                                    <span>Cuando existan proveedores activos, aparecerán aquí.</span>
                                </div>
                            </td>
                        </tr>
                    }

                    @foreach (var proveedor in Model.Proveedores)
                    {
                        <tr>
                            <td class="fj-td-codigo">
                                <span class="fj-codigo">@proveedor.Id</span>
                            </td>
                            <td><span class="fj-nombre">@proveedor.RazonSocial</span></td>
                            <td class="fj-td-secundario">@proveedor.Contacto</td>
                            <td class="fj-td-secundario">@proveedor.Telefono</td>
                            <td class="fj-td-secundario">
                                @(string.IsNullOrWhiteSpace(proveedor.NombreResponsable) ? "No registrado" : proveedor.NombreResponsable)
                            </td>
                            <td>
                                <span class="fj-pill" style="--pill: @(proveedor.Estado ? "var(--success)" : "var(--texto-ter)");">
                                    @(proveedor.Estado ? "Activo" : "Inactivo")
                                </span>
                                @if (!proveedor.Estado && proveedor.FechaBaja is DateTime fechaBaja)
                                {
                                    <span class="fj-nombre-sub">Baja: @fechaBaja.ToString("g", cultura)</span>
                                }
                            </td>
                            <td class="fj-td-acciones">
                                <div class="fj-acciones">
                                    <a class="fj-btn fj-btn-ghost fj-btn-sm fj-btn-detalle"
                                       asp-page="./Detalle"
                                       asp-route-id="@proveedor.Id"
                                       title="Consultar proveedor"
                                       aria-label="Consultar proveedor">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" /><circle cx="12" cy="12" r="3" /></svg>
                                        Ver
                                    </a>

                                    <a class="fj-btn fj-btn-edit fj-btn-sm"
                                       asp-page="./Editar"
                                       asp-route-id="@proveedor.Id"
                                       title="Editar proveedor"
                                       aria-label="Editar proveedor">Editar</a>

                                    @if (proveedor.Estado)
                                    {
                                        <form method="post"
                                              asp-page-handler="Eliminar"
                                              asp-route-id="@proveedor.Id"
                                              asp-route-orden="@Model.Orden"
                                              class="fj-inline-form"
                                              data-fj-confirm="¿Está seguro de dar de baja al proveedor '@proveedor.RazonSocial'? Podrá reactivarlo después.">
                                            <button type="submit" class="fj-btn fj-btn-danger fj-btn-icon" title="Dar de baja proveedor" aria-label="Dar de baja proveedor">
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="3 6 5 6 21 6" /><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" /></svg>
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form method="post"
                                              asp-page-handler="Reactivar"
                                              asp-route-id="@proveedor.Id"
                                              asp-route-orden="@Model.Orden"
                                              class="fj-inline-form"
                                              data-fj-confirm="¿Desea reactivar al proveedor '@proveedor.RazonSocial'?">
                                            <button type="submit" class="fj-btn fj-btn-ghost fj-btn-icon" title="Reactivar proveedor" aria-label="Reactivar proveedor">
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7L3 8" /><polyline points="3 3 3 8 8 8" /></svg>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

</div>

<partial name="_ConfirmModal" />
