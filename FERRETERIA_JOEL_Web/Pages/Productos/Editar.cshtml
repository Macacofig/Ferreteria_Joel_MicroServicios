@page
@model FERRETERIA__Joel.Pages.Productos.EditarModel
@{
    ViewData["Title"] = "Editar Producto";
    ViewData["ActiveMenu"] = "Productos";
}
@section Styles {
    <link rel="stylesheet" href="~/css/productos.css" asp-append-version="true" />
    <style>
        .fj-form-producto {
            padding: 28px 32px;
            box-sizing: border-box;
        }

        .fj-form-producto *,
        .fj-form-producto *::before,
        .fj-form-producto *::after {
            box-sizing: border-box;
        }

        .fj-form-producto .fj-fila {
            display: grid;
            gap: 20px;
            margin-bottom: 20px;
        }

        .fj-form-producto .fj-fila--ultima {
            margin-bottom: 0;
        }

        .fj-form-producto .fj-fila-2 {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .fj-form-producto .fj-fila-3 {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }

        .fj-form-producto .fj-fila-1 {
            grid-template-columns: minmax(0, 1fr);
        }

        .fj-form-producto .fj-campo {
            min-width: 0;
        }

        .fj-form-producto .form-label {
            display: block;
            margin-bottom: 6px;
            font-weight: 600;
        }

        .fj-form-producto .form-control,
        .fj-form-producto .form-select {
            width: 100%;
            box-sizing: border-box;
        }

        .fj-form-producto .fj-codigo-autogenerado {
            background-color: #f3f4f6;
            cursor: not-allowed;
        }

        .fj-form-producto .fj-barra-botones {
            display: flex;
            justify-content: flex-end;
            align-items: center;
            gap: 12px;
            margin-top: 24px;
            padding-top: 20px;
            border-top: 1px solid #eef0f3;
        }

        .fj-form-producto .fj-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            min-height: 42px;
            padding: 0.625rem 1rem;
            line-height: 1.2;
            white-space: nowrap;
        }

        .fj-form-producto .fj-btn svg {
            width: 1rem;
            height: 1rem;
            flex: none;
        }

        @@media (max-width: 640px) {
            .fj-form-producto {
                padding: 20px;
            }

            .fj-form-producto .fj-fila-2,
            .fj-form-producto .fj-fila-3 {
                grid-template-columns: 1fr;
            }

            .fj-form-producto .fj-barra-botones {
                justify-content: center;
                flex-wrap: wrap;
            }
        }
    </style>
}

<div class="fj-container fj-page-products">

    <section class="fj-page-head">
        <p class="fj-eyebrow">Módulo · Catálogo · Edición</p>
        <h1>Edición de Producto</h1>
        <p class="fj-page-sub">
            Actualización de los datos de
            <strong>@(string.IsNullOrWhiteSpace(Model.NombreProducto) ? "producto" : Model.NombreProducto)</strong>.
        </p>
    </section>

    @if (!string.IsNullOrWhiteSpace(Model.Error))
    {
        <div class="fj-alert" role="alert">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10" /><line x1="12" y1="8" x2="12" y2="12" /><line x1="12" y1="16" x2="12.01" y2="16" /></svg>
            <span>@Model.Error</span>
        </div>
    }

    <section class="fj-card" aria-label="Formulario de edición de producto">
        <form method="post" class="fj-form-producto">
            <input type="hidden" asp-for="IdProducto" />

            <div class="fj-fila fj-fila-2">
                <div class="fj-campo">
                    <label class="form-label" asp-for="Solicitud.Codigo">Código</label>
                    <input class="form-control fj-codigo-autogenerado" asp-for="Solicitud.Codigo" maxlength="30" readonly required />
                    <span class="text-danger" asp-validation-for="Solicitud.Codigo"></span>
                </div>

                <div class="fj-campo">
                    <label class="form-label" asp-for="Solicitud.Nombre">Nombre</label>
                    <input class="form-control" asp-for="Solicitud.Nombre" maxlength="150" required />
                    <span class="text-danger" asp-validation-for="Solicitud.Nombre"></span>
                </div>
            </div>

            <div class="fj-fila fj-fila-2">
                <div class="fj-campo">
                    <label class="form-label" asp-for="Solicitud.IdCategoria">Categoría</label>
                    <select class="form-select" asp-for="Solicitud.IdCategoria" required>
                        <option value="">Seleccione una categoría</option>
                        @foreach (var categoria in Model.Categorias)
                        {
                            <option value="@categoria.IdCategoria">@categoria.Nombre</option>
                        }
                    </select>
                    <span class="text-danger" asp-validation-for="Solicitud.IdCategoria"></span>
                </div>

                <div class="fj-campo">
                    <label class="form-label" asp-for="Solicitud.IdMarca">Marca</label>
                    <select class="form-select" asp-for="Solicitud.IdMarca" required>
                        <option value="">Seleccione una marca</option>
                        @foreach (var marca in Model.Marcas)
                        {
                            <option value="@marca.IdMarca">@marca.Nombre</option>
                        }
                    </select>
                    <span class="text-danger" asp-validation-for="Solicitud.IdMarca"></span>
                </div>
            </div>

            <div class="fj-fila fj-fila-3">
                <div class="fj-campo">
                    <label class="form-label" asp-for="Solicitud.UnidadMedida">Unidad de Medida</label>
                    <select class="form-select" asp-for="Solicitud.UnidadMedida" required>
                        <option value="">Seleccione una unidad de medida</option>
                        @foreach (var unidad in Model.UnidadesMedida)
                        {
                            <option value="@unidad">@unidad</option>
                        }
                    </select>
                    <span class="text-danger" asp-validation-for="Solicitud.UnidadMedida"></span>
                </div>

                <div class="fj-campo">
                    <label class="form-label" asp-for="Solicitud.PrecioVenta">Precio de Venta (Bs.)</label>
                    <input class="form-control" asp-for="Solicitud.PrecioVenta" type="number" step="0.01" min="0.01" required />
                    <span class="text-danger" asp-validation-for="Solicitud.PrecioVenta"></span>
                </div>

                <div class="fj-campo">
                    <label class="form-label" asp-for="Solicitud.CantidadStock">Cantidad de Stock</label>
                    <input class="form-control" asp-for="Solicitud.CantidadStock" type="number" step="1" min="0" required />
                    <span class="text-danger" asp-validation-for="Solicitud.CantidadStock"></span>
                </div>
            </div>

            <div class="fj-fila fj-fila-1 fj-fila--ultima">
                <div class="fj-campo">
                    <label class="form-label" asp-for="Solicitud.Descripcion">Descripción</label>
                    <textarea class="form-control" asp-for="Solicitud.Descripcion" maxlength="500" rows="3"></textarea>
                    <span class="text-danger" asp-validation-for="Solicitud.Descripcion"></span>
                </div>
            </div>

            <div class="fj-barra-botones">
                <a class="fj-btn fj-btn-ghost" asp-page="/Productos/Index">Cancelar</a>
                <button type="submit" class="fj-btn fj-btn-primary">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z" /><polyline points="17 21 17 13 7 13 7 21" /><polyline points="7 3 7 8 15 8" /></svg>
                    Guardar Cambios
                </button>
            </div>
        </form>
    </section>

</div>
